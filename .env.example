
# ─── Real-user load speed (optional) ─────────────────────────────────────────
# MiniPay's listing review grades load speed on the 75th percentile of REAL
# users, which a PageSpeed run cannot tell you. Set a PostHog project key here
# and the app reports Web Vitals (LCP/INP/CLS/FCP/TTFB) for every pageview.
#
# Leave this unset and the measurement is completely inert: no network, and the
# web-vitals library is never even downloaded. That is how it ships.
#
# Read the p75 in PostHog with the HogQL query in lib/webVitals.ts's references,
# or use PostHog's built-in Web Vitals dashboard — the event shape is identical
# to what posthog-js emits, so both work unchanged.
NEXT_PUBLIC_POSTHOG_KEY=
# Only needed if your PostHog project is not on US cloud (e.g. https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=

# ─── Show that load speed on /stats (optional, server-side only) ─────────────
# Reads the p75 back OUT of PostHog so /stats can display it — MiniPay's guide
# recommends surfacing it so a reviewer can see load speed without testing it
# themselves.
#
# This is the PERSONAL API key (phx_), which can read everything in the
# account. Note there is NO NEXT_PUBLIC_ prefix, and that is deliberate: the
# query runs on the server and the browser only ever receives the five
# aggregate numbers. Never rename these with a NEXT_PUBLIC_ prefix.
#
# Where to get them:
#   POSTHOG_PERSONAL_API_KEY — PostHog → Settings → Account → Personal API keys
#                              → Create. Scope it to READ on "Query" only; it
#                              does not need anything else.
#   POSTHOG_PROJECT_ID       — the number in the PostHog URL:
#                              us.posthog.com/project/<THIS NUMBER>/...
#
# Leave unset and the speed card simply does not render. Everything else on
# /stats is unaffected.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Only if not on US cloud (e.g. https://eu.i.posthog.com)
POSTHOG_HOST=

# ─── Celo RPC (optional) ─────────────────────────────────────────────────────
# Which endpoint(s) the app reads and writes Celo through. Unset means
# https://forno.celo.org alone, which is what ships — free, and documented as
# rate-limited. Every player's browser reads balances, pass status and vault
# state through it, so the load is per-player, not per-server.
#
# Comma-separated for a fallback chain, tried in order:
#   NEXT_PUBLIC_CELO_RPC=https://primary.example,https://backup.example
#
# CELO_RPC_URL wins on the SERVER and is never compiled into the browser
# bundle — use it for a URL that carries a provider key. NEXT_PUBLIC_CELO_RPC
# is readable by anyone who opens devtools, so never put a key in it.
#
# Both are read in exactly one place: lib/celoRpc.ts. `npm run audit` fails if
# any other file names an endpoint, because they used to disagree.
NEXT_PUBLIC_CELO_RPC=
CELO_RPC_URL=

# ─── Public URL (set this when a real domain is connected) ───────────────────
# The canonical origin of the app. Unset means the Vercel subdomain, which is
# what ships today. Read in exactly one place, lib/siteUrl.ts, which feeds the
# OpenGraph metadata base, robots.txt, the sitemap and the SERVER-SIDE Celo
# attribution hostname. `npm run audit` fails if any other file names it.
#
# With or without a trailing slash; it is stripped. Origin only — no path.
NEXT_PUBLIC_SITE_URL=

# ─── Celo attribution code — SET THIS BEFORE MOVING DOMAINS ──────────────────
# READ THIS BEFORE YOU CONNECT A CUSTOM DOMAIN. See docs/custom-domain.md.
#
# The Celo app code (ERC-8021) is a hash of the hostname. Move to a new domain
# without pinning and the code changes with it, so Celo's dashboard sees the old
# transactions and the new ones as two unrelated apps. Attribution cannot be
# backfilled, so everything earned under the old host stays stranded there.
#
# Pin the CURRENT code before switching, not after:
#   celo_135bf4523d70    ← nullstate-ten.vercel.app, as of 2026-07
#
# Once pinned it must never change again.
NEXT_PUBLIC_CELO_ATTRIBUTION_CODE=

# ─── Season close (GAME-DESIGN.md §9) ────────────────────────────────────────
# The monthly top-3 bonus is paid BY HAND, on purpose: the deployer key that
# owns both reward contracts stays on the owner's device and never reaches a
# server. What is automated is everything up to the signature.
#
# CRON_SECRET   Vercel sends this as `Authorization: Bearer <secret>` on the
#               scheduled call to /api/cron/season (01:00 UTC daily, see
#               vercel.json). That route freezes the ranking for the month that
#               just ended and writes ONE record; on every other day it finds
#               the snapshot already there and writes nothing. It runs daily
#               rather than monthly so a firing missed on the 1st — a deploy in
#               flight, a cold start — self-heals the next morning instead of
#               waiting a month. It refuses to run without this set: an
#               unauthenticated caller must never be able to freeze a ranking
#               early, because the snapshot is written once and never rewritten.
#
#               Run it by hand (recovery for a missed month):
#                 curl -H "Authorization: Bearer $CRON_SECRET" \
#                      https://<host>/api/cron/season
#
# ADMIN_SECRET  Sent as `x-admin-secret` to POST /api/season/status to mark a
#               season paid AFTER you have signed the two deposit-reward.js
#               commands yourself. It only ever sets a flag: it cannot move
#               money and cannot change who won. Also refuses without this set.
#
# Both are plain random strings — generate with `openssl rand -hex 32`. Neither
# is a key and neither can spend anything.
CRON_SECRET=
ADMIN_SECRET=

# ── PRIVY GATE (TEMPORARY — talent.app judging period) ───────────────────────
#
# A wallet + Google login in ONE modal, shown once after the splash to players
# OUTSIDE MiniPay. Inside MiniPay it never appears: MiniPay resolves an address
# with zero clicks and its listing rules reject a screen between the player and
# the game, so the gate reuses the same `!isMiniPay` guard the Firebase sign-in
# already had.
#
# OFF unless BOTH are set. Leave them empty and nothing changes for anybody —
# which is the state this ships in, because a judging-period feature that ships
# enabled becomes permanent by forgetting.
#
#   1. Create an app at https://dashboard.privy.io
#   2. Login methods: enable Google, Email and Wallet
#   3. Allowed domains: add playnullstate.xyz (and the Vercel preview domain)
#   4. Paste the App ID below, set the gate to 1, redeploy
#
# To turn it off after the judging: set NEXT_PUBLIC_PRIVY_GATE=0 and redeploy.
# Nothing was removed — the original Google/email sign-in returns as it was.
#
# Per-device testing without changing the deployment: ?privy=1 / ?privy=0
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_GATE=0
